# Live wallet exports contain signed transactions and Atomic BEEF. A no-send
# marker does not make them safe to publish: anyone with the complete package
# may be able to submit it. Only the explicitly allowlisted transaction that is
# already public on mainnet belongs in Git.
adinals-collection-*.json
tests/fixtures/collections/*.json

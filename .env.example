# No environment variables are required for the production application.
# Production `app=adinals` and both publication paths are the built-in defaults.

# Uncomment only for deliberate throwaway-namespace testing.
# VITE_ADINALS_ENV=development

# Optional explicit development overrides; normally leave these unset.
# VITE_ADINALS_APP=adinals-brc100-test
# VITE_ADINALS_BASKET=adinals brc100 test
# VITE_ADINALS_KEY_PROTOCOL=adinals brc100 test
# VITE_ADINALS_ACTION_LABEL=adinals brc100 test action
# VITE_ADINALS_OVERLAY_TOPIC=tm_adinals_brc100_test

# Optional emergency/read-only build switches.
# VITE_ENABLE_COLLECTION_PUBLISH=false
# VITE_ENABLE_LIFECYCLE_PUBLISH=false

# Deferred transfer transport; unused by the simplified self-minting product.
# VITE_MESSAGEBOX_HOST=https://messagebox.babbage.systems

# Reserved identity-scoped inbox for a later incoming-transfer phase.
# VITE_ADINALS_MESSAGEBOX=adinals_brc100_test_inbox
